# No runtime environment variables are currently required by this app.
# The branch map uses keyless ArcGIS raster tiles (see components/CaptainsMap.tsx).
#
# If a keyed tile provider is adopted later, declare it here with a placeholder value.
# Never commit a real key: anything prefixed NEXT_PUBLIC_ is exposed to the browser.
# NEXT_PUBLIC_MAP_TILES_API_KEY=your_key_here
